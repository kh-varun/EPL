# Token for football-data.org (https://www.football-data.org/client/register)
# Used by scripts/fetch.mjs to pull standings, fixtures, results and squads.
FOOTBALL_DATA_TOKEN=your_token_here

# Key for API-Football (https://dashboard.api-football.com) - free plan, no card.
# Used by scripts/fetch-lineups.mjs (confirmed starting XIs), fetch-history.mjs
# (last-season player stats), fetch-odds.mjs doesn't need it (Kalshi is public),
# and fetch.mjs (current manager name - football-data.org's own value is often stale).
API_FOOTBALL_KEY=your_key_here

# Optional. Key for Highlightly (https://highlightly.net) - free plan, 100
# req/day, no card. Used by fetch-lineups.mjs as a second, independent
# cross-check of API-Football's confirmed lineup (logged only - never shown
# to users on its own). Without it, that cross-check is skipped; the ESPN
# cross-check runs regardless since it needs no key.
HIGHLIGHTLY_API_KEY=your_key_here
