# Token for football-data.org (https://www.football-data.org/client/register)
# Used by scripts/fetch.mjs to pull standings, fixtures, results and squads.
FOOTBALL_DATA_TOKEN=your_token_here

# Key for API-Football (https://dashboard.api-football.com) - free plan, no card.
# Used by scripts/fetch-lineups.mjs to pull confirmed match-day starting XIs.
API_FOOTBALL_KEY=your_key_here
